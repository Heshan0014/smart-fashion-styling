# Email Configuration Template
# Copy this file to .env and fill in your email credentials

# Gmail Configuration (Recommended for Development)
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# Alternative: SendGrid Configuration
# MAIL_USERNAME=apikey
# MAIL_PASSWORD=SG.your-sendgrid-api-key

# Alternative: Custom SMTP Configuration
# MAIL_HOST=smtp.your-provider.com
# MAIL_PORT=587
# MAIL_USERNAME=your-username
# MAIL_PASSWORD=your-password

# Application Configuration
FRONTEND_URL=http://localhost:3000
RESET_TOKEN_EXPIRY=60

# Optional: Sender Email (if different from MAIL_USERNAME)
# MAIL_FROM=noreply@smartfashion.com

# Database Configuration (if needed)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/smart_fashion
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=postgres

# JWT Configuration (if needed)
# JWT_SECRET=your-super-secret-key-change-in-production
